{
  "name": "vault",
  "version": "0.1.0",
  "description": "Desktop app for organizing musical ideas",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'},null,2))\"",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite",
    "rebuild": "node ./node_modules/@electron/rebuild/lib/cli.js -f -w better-sqlite3",
    "postinstall": "npm run rebuild",
    "start": "npm run build:main && electron .",
    "test": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "generate:icons": "bash scripts/generate-icns.sh && bash scripts/generate-ico.sh",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "make:mac": "npm run build && electron-forge make --platform=darwin",
    "make:win": "npm run build && electron-forge make --platform=win32"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
