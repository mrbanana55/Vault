{
  "name": "vault",
  "version": "0.1.0",
  "description": "Desktop app for organizing musical ideas",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'},null,2))\"",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "start": "electron .",
    "test": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
